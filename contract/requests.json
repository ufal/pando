{
  "format_version": 1,
  "about": "Requests to pando-server (any ServerApi transport answers the same), one per result kind. contract_test.py replays them on corpus.jsonl and compares each answer's shape with answers/NAME.json. {var} is a value an earlier request saved.",
  "requests": [
    {"name": "query_hits", "method": "POST", "path": "/query", "body": {"query": "a:[upos=\"NOUN\"]", "limit": 5}},
    {"name": "query_region_groups", "method": "POST", "path": "/query", "body": {"query": "n:<np> [upos=\"DET\"]", "limit": 5}},
    {"name": "query_fragment", "method": "POST", "path": "/query", "body": {"query": "n:<np> [upos=\"DET\"]", "limit": 2, "fragment": true}},
    {"name": "query_aligned_pieces", "method": "POST", "path": "/query", "body": {"query": "[lemma=\"cat\"]", "limit": 5, "aligned": "s_tuid"}},
    {"name": "query_async_total", "method": "POST", "path": "/query", "body": {"query": "[upos=\"NOUN\"]", "limit": 2, "total": "async"}, "save": {"job": "result.job_id"}},
    {"name": "status", "method": "GET", "path": "/status?job={job}"},
    {"name": "cancel", "method": "POST", "path": "/cancel", "body": {"job": "{job}"}},
    {"name": "jobs", "method": "GET", "path": "/jobs"},
    {"name": "query_total_only", "method": "POST", "path": "/query", "body": {"query": "[upos=\"NOUN\"]", "limit": 0}},
    {"name": "query_sample", "method": "POST", "path": "/query", "body": {"query": "[]", "limit": 5, "sample": 3, "seed": 1}},
    {"name": "query_dialect_cwb", "method": "POST", "path": "/query", "body": {"query": "[lemma=\"cat\"]", "limit": 5, "dialect": "cwb"}},
    {"name": "query_default_attr", "method": "POST", "path": "/query", "body": {"query": "\"cat\"", "limit": 5, "dialect": "manatee-cql", "default_attr": "lemma"}},
    {"name": "query_kwic_view", "method": "POST", "path": "/query", "body": {"query": "[lemma=\"cat\"]", "limit": 2, "dialect": "manatee-cql", "kwic_view": {"left": "-40#", "right": "40#", "attrs": "word,lemma", "ctxattrs": "word,lemma", "structs": "s,text.id", "refs": "=text.id,#"}}},
    {"name": "query_kwic_view_sentence", "method": "POST", "path": "/query", "body": {"query": "[upos=\"DET\"] [upos=\"NOUN\"]", "limit": 2, "kwic_view": {"left": "-1:s", "right": "1:s", "attrs": "word", "structs": "s", "refs": "s"}}},
    {"name": "pairs_with", "method": "POST", "path": "/query", "body": {"query": "a:[lemma=\"cat\"] with b:[] :: a.s_tuid = b.s_tuid", "limit": 5}},
    {"name": "pairs_equivalence", "method": "POST", "path": "/query", "body": {"query": "a:[lemma=\"cat\"] =:s_tuid b:[]", "limit": 5}},

    {"name": "run_count", "method": "POST", "path": "/run", "body": {"cql": "a:[upos=\"NOUN\"]; count by a.lemma", "limit": 5}},
    {"name": "run_count_hierarchy", "method": "POST", "path": "/run", "body": {"cql": "a:[upos=\"VERB\"] > b:[upos=\"NOUN\"]; count by a.lemma, b.lemma", "limit": 5}},
    {"name": "run_count_hierarchy_cut", "method": "POST", "path": "/run", "body": {"cql": "a:[]; count by a.text_lang, a.upos", "limit": 5, "group_limit": 1, "child_limit": 2}},
    {"name": "run_freq", "method": "POST", "path": "/run", "body": {"cql": "[upos=\"NOUN\"]; freq by lemma", "limit": 5}},
    {"name": "run_freq_compare", "method": "POST", "path": "/run", "body": {"cql": "A = [upos=\"NOUN\"]; B = [upos=\"VERB\"]; freq A, B by text_lang", "limit": 5}},
    {"name": "run_stats", "method": "POST", "path": "/run", "body": {"cql": "a:[]; stats avg(strlen(a.form)) by a.text_lang", "limit": 5}},
    {"name": "run_tabulate", "method": "POST", "path": "/run", "body": {"cql": "a:[upos=\"NOUN\"]; tabulate a.lemma, a.upos", "limit": 5}},
    {"name": "run_describe", "method": "POST", "path": "/run", "body": {"cql": "a:[upos=\"NOUN\"]; describe", "limit": 5}},
    {"name": "run_raw", "method": "POST", "path": "/run", "body": {"cql": "[upos=\"NOUN\"]; raw", "limit": 5}},
    {"name": "run_coll", "method": "POST", "path": "/run", "body": {"cql": "set min-freq 1; [upos=\"VERB\"]; coll by lemma", "limit": 5}},
    {"name": "run_dcoll", "method": "POST", "path": "/run", "body": {"cql": "set min-freq 1; a:[upos=\"VERB\"]; dcoll children by lemma", "limit": 5}},
    {"name": "run_keyness", "method": "POST", "path": "/run", "body": {"cql": "set min-freq 1; A = [upos=\"NOUN\"] :: match.text_lang = \"en\"; keyness A by lemma", "limit": 5}},
    {"name": "run_size", "method": "POST", "path": "/run", "body": {"cql": "[upos=\"NOUN\"]; size", "limit": 5}},
    {"name": "run_arf", "method": "POST", "path": "/run", "body": {"cql": "[upos=\"NOUN\"]; arf", "limit": 5}},
    {"name": "run_sort", "method": "POST", "path": "/run", "body": {"cql": "A = [upos=\"NOUN\"]; sort A by lemma", "limit": 5}},
    {"name": "run_sort_kwic_view", "method": "POST", "path": "/run", "body": {"cql": "A = \"cat\"; sort A by lemma", "limit": 2, "dialect": "manatee-cql", "default_attr": "lemma", "kwic_view": {"left": "-3", "right": "3", "attrs": "word", "structs": "s"}}},
    {"name": "run_assign", "method": "POST", "path": "/run", "body": {"cql": "A = [upos=\"NOUN\"]", "limit": 5}},
    {"name": "run_drop", "method": "POST", "path": "/run", "body": {"cql": "A = [upos=\"NOUN\"]; drop A", "limit": 5}},
    {"name": "run_set", "method": "POST", "path": "/run", "body": {"cql": "set limit 5", "limit": 5}},
    {"name": "run_show_info", "method": "POST", "path": "/run", "body": {"cql": "show info", "limit": 5}},
    {"name": "run_show_attributes", "method": "POST", "path": "/run", "body": {"cql": "show attributes", "limit": 5}},
    {"name": "run_show_regions", "method": "POST", "path": "/run", "body": {"cql": "show regions", "limit": 5}},
    {"name": "run_show_regions_of_type", "method": "POST", "path": "/run", "body": {"cql": "show regions np", "limit": 5}},
    {"name": "run_show_values", "method": "POST", "path": "/run", "body": {"cql": "show values lemma", "limit": 5}},
    {"name": "run_show_named", "method": "POST", "path": "/run", "body": {"cql": "A = [upos=\"NOUN\"]; show named", "limit": 5}},
    {"name": "run_show_settings", "method": "POST", "path": "/run", "body": {"cql": "show settings", "limit": 5}},

    {"name": "info", "method": "GET", "path": "/info"},
    {"name": "values", "method": "GET", "path": "/values/lemma?limit=3"},
    {"name": "regions", "method": "GET", "path": "/regions/np?limit=3"},
    {"name": "context", "method": "GET", "path": "/context?pos=2&left=2&right=2"},
    {"name": "health", "method": "GET", "path": "/health"},
    {"name": "version", "method": "GET", "path": "/version"},
    {"name": "warm", "method": "GET", "path": "/warm"},

    {"name": "subcorpus_route", "method": "POST", "path": "/subcorpus", "body": {"definition": "t:<text lang=\"en\">"}},
    {"name": "subcorpus_route_tokens", "method": "POST", "path": "/subcorpus", "body": {"definition": "([upos=\"NOUN\"]) - (t:<text lang=\"nl\">)"}},
    {"name": "query_subcorpus_use", "method": "POST", "path": "/query", "body": {"query": "[upos=\"NOUN\"]", "limit": 2, "total": true, "subcorpus": {"definition": "t:<text lang=\"en\">", "name": "English"}}},
    {"name": "query_subcorpus_within", "method": "POST", "path": "/query", "body": {"query": "[upos=\"NOUN\"]", "limit": 2, "subcorpus": {"definition": "t:<text lang=\"en\">", "mode": "within"}}},
    {"name": "run_subcorpus_freq", "method": "POST", "path": "/run", "body": {"cql": "[upos=\"NOUN\"]; freq by lemma", "limit": 5, "subcorpus": {"definition": "t:<text lang=\"en\">", "name": "English"}}},
    {"name": "run_subcorpus_define", "method": "POST", "path": "/run", "body": {"cql": "EN = (t:<text lang=\"en\">) | (t:<text year=\"1990\">)", "limit": 5}},
    {"name": "run_use", "method": "POST", "path": "/run", "body": {"cql": "use (t:<text lang=\"en\">); [upos=\"NOUN\"]; freq by lemma", "limit": 5}},
    {"name": "run_use_reset", "method": "POST", "path": "/run", "body": {"cql": "use", "limit": 5}},
    {"name": "error_subcorpus_definition", "method": "POST", "path": "/subcorpus", "body": {"definition": "[upos=\"NOUN\""}, "status": 400},
    {"name": "error_subcorpus_mode", "method": "POST", "path": "/query", "body": {"query": "[]", "subcorpus": {"definition": "[]", "mode": "inside"}}, "status": 400},

    {"name": "session_create", "method": "POST", "path": "/session", "body": {}, "save": {"session": "session_id"}},
    {"name": "query_in_session", "method": "POST", "path": "/query", "body": {"query": "[upos=\"NOUN\"]", "limit": 2, "session_id": "{session}", "name": "N"}},
    {"name": "query_from_named_set", "method": "POST", "path": "/query", "body": {"from": "N", "limit": 2, "offset": 1, "session_id": "{session}"}},
    {"name": "run_in_session", "method": "POST", "path": "/run", "body": {"cql": "count N by lemma", "limit": 5, "session_id": "{session}"}},
    {"name": "session_info", "method": "GET", "path": "/session?session_id={session}"},
    {"name": "sessions", "method": "GET", "path": "/sessions"},
    {"name": "session_close", "method": "POST", "path": "/session/close", "body": {"session_id": "{session}"}},

    {"name": "error_syntax", "method": "POST", "path": "/query", "body": {"query": "[upos=\"NOUN\"", "limit": 5}, "status": 400},
    {"name": "error_in_program", "method": "POST", "path": "/run", "body": {"cql": "[upos=\"NOUN\"]; freq", "limit": 5}},
    {"name": "error_unknown_route", "method": "GET", "path": "/nothing", "status": 404},
    {"name": "error_wrong_method", "method": "GET", "path": "/query", "status": 405},
    {"name": "error_unknown_session", "method": "GET", "path": "/session?session_id=no-such-session", "status": 404},
    {"name": "error_unknown_job", "method": "GET", "path": "/status?job=no-such-job", "status": 404},
    {"name": "error_unknown_attribute", "method": "GET", "path": "/values/nothing", "status": 404}
  ]
}
